# Canonical public origin of the deployed Calyx backend, without a trailing slash.
# University learner, reviewer, and Mission Control traffic all resolve from this value.
# Example: https://calyx-api.example.org
VITE_CALYX_API_URL=

# Backward-compatible aliases are still recognized if VITE_CALYX_API_URL is absent:
# VITE_CALYX_BACKEND_BASE_URL=
# VITE_MISSION_CONTROL_BACKEND_URL=

# Canonical public origin of the Orchid Continuum PUBLIC API, without a
# trailing slash. This is a DIFFERENT service from VITE_CALYX_API_URL above.
#
# Leaving it unset is not cosmetic. src/lib/api.ts fails closed without it, so
# the widget gallery, Orchid Zoo, OACS, the Applied AI lab's Atlas panel and
# the scientific-observability review queue all render as unavailable, while
# the rest of the site keeps working. That split is confusing to diagnose,
# which is why it is documented here rather than left implicit.
#
# NEXT_PUBLIC_API_BASE_URL is accepted as an alias for Next.js portability.
VITE_API_BASE_URL=

# Optional release identifier surfaced by hosting or observability tooling.
VITE_RELEASE_SHA=

# Mapbox PUBLIC access token, used only for the regional scales of the Living
# Atlas (state / landscape / locality). The globe does not need it.
#
# It MUST be a public pk.* token — browser bundles are public, so a secret sk.*
# token must never be set here. Restrict the token by URL in the Mapbox account
# against the deployed origins.
#
# When this is unset the Atlas stays on the globe and says so; it never degrades
# to a broken map.
VITE_MAPBOX_TOKEN=

# Optional Mapbox style override. Defaults to mapbox://styles/mapbox/dark-v11,
# chosen to sit continuously beside the globe rather than look like a different
# product.
VITE_MAPBOX_STYLE_URL=

# Identity/database origin for the browser bundle, and its PUBLIC anon key.
# Both default to the shipped hosted project when unset, so existing
# deployments need no change. Override them to point a preview build, a
# separate university deployment, or an automated browser journey at an
# identity project that is not production.
#
# VITE_SUPABASE_ANON_KEY must be the project's `anon` key. It is published in
# the client bundle; a service-role key must never be set here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
