# Canonical public origin of the deployed Calyx backend, without a trailing slash.
# University learner, reviewer, and Mission Control traffic all resolve from this value.
# Example: https://calyx-api.example.org
VITE_CALYX_API_URL=

# Backward-compatible aliases are still recognized if VITE_CALYX_API_URL is absent:
# VITE_CALYX_BACKEND_BASE_URL=
# VITE_MISSION_CONTROL_BACKEND_URL=

# Optional release identifier surfaced by hosting or observability tooling.
VITE_RELEASE_SHA=

# Mapbox PUBLIC access token, used only for the regional scales of the Living
# Atlas (state / landscape / locality). The globe does not need it.
#
# It MUST be a public pk.* token — browser bundles are public, so a secret sk.*
# token must never be set here. Restrict the token by URL in the Mapbox account
# against the deployed origins.
#
# When this is unset the Atlas stays on the globe and says so; it never degrades
# to a broken map.
VITE_MAPBOX_TOKEN=

# Optional Mapbox style override. Defaults to mapbox://styles/mapbox/dark-v11,
# chosen to sit continuously beside the globe rather than look like a different
# product.
VITE_MAPBOX_STYLE_URL=
