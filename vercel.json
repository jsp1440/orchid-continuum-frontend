{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/research-station",
      "destination": "/researcher-jeffery-scott-parham.html"
    },
    {
      "source": "/research-station/about",
      "destination": "/researcher-jeffery-scott-parham.html"
    },
    {
      "source": "/research-station/researchers/jeffery-scott-parham",
      "destination": "/researcher-jeffery-scott-parham.html"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|robots\\.txt|sitemap\\.xml|research-station-profile\\.css|researcher-jeffery-scott-parham\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/researcher-jeffery-scott-parham.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
